# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GOOGLE_SHEETS_ID: O ID da planilha no Google Sheets para o Data SocIAl
GOOGLE_SHEETS_ID="1OCJjWhV9CzI9fOt9NqpVmfin5lDciyz2GASCE80d5eE"

# GOOGLE_SERVICE_ACCOUNT_EMAIL: E-mail da Conta de Serviço do Google Cloud
GOOGLE_SERVICE_ACCOUNT_EMAIL=""

# GOOGLE_PRIVATE_KEY: Chave privada da Conta de Serviço do Google
GOOGLE_PRIVATE_KEY=""
